{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forma-zieleni.local/contracts/learning-record.schema.json",
  "title": "FZ learning record",
  "type": "object",
  "additionalProperties": false,
  "required": ["patternKey", "source", "scope", "signalType", "severity", "observation", "evidence", "generalizability", "privacyClassification"],
  "properties": {
    "id": { "type": "string", "pattern": "^LR-[0-9]{8}-[a-f0-9]{8}$" },
    "patternKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){1,8}$" },
    "status": { "enum": ["OBSERVED", "HYPOTHESIS", "VALIDATING", "PROVEN", "REJECTED", "PROMOTED", "SUPERSEDED", "DEFERRED"] },
    "source": { "enum": ["test", "production", "review", "grok", "coderabbit", "owner", "security", "performance", "ux", "customer", "search", "incident", "agent", "manual-toil", "experiment"] },
    "scope": { "type": "string", "minLength": 2, "maxLength": 120 },
    "signalType": { "enum": ["failure", "near-miss", "success", "toil", "assumption", "review-finding", "incident", "experiment"] },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "observation": { "type": "string" },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "hypothesis": { "type": "string" },
    "rootCause": { "type": "string" },
    "generalizability": { "enum": ["ONE-OFF", "LOCAL", "RECURRING", "SYSTEMIC", "CRITICAL"] },
    "evidenceStrength": { "enum": ["ANECDOTAL", "REPEATED", "TESTED", "MEASURED", "STRONG"] },
    "proposedImprovement": { "type": "string" },
    "validationMethod": { "type": "string" },
    "promotionTarget": { "enum": ["CODE", "TEST", "CONTRACT", "TYPE", "SCHEMA", "LINT", "REPO_CHECK", "SECURITY_CONTROL", "OBSERVABILITY", "SLO", "RUNBOOK", "ADR", "CANON", "SKILL", "AGENT", "HOOK", "AUTOMATION", "DESIGN_SYSTEM", "CONTENT_RULE", "PRODUCT_RULE"] },
    "relatedSlice": { "type": "string" },
    "relatedCommit": { "type": "string" },
    "relatedTest": { "type": "string" },
    "ownerGate": { "enum": ["OWNER-DECISION", "OWNER-ONLY", "DANGEROUS"] },
    "gateDisposition": { "const": "PRESERVED" },
    "privacyClassification": { "enum": ["PUBLIC", "INTERNAL"] },
    "horizon": { "enum": ["FOUNDATION_NOW", "WHEN_PRODUCT_EXISTS", "PRODUCTION_LATER", "BACKLOG"] },
    "occurrences": { "type": "integer", "minimum": 1 },
    "validatedLocally": { "type": "boolean" },
    "locallyVerified": { "type": "boolean" },
    "causality": { "const": "OBSERVED_ASSOCIATION" },
    "firstSeen": { "type": "string" },
    "lastSeen": { "type": "string" },
    "rejectionReason": { "type": "string" },
    "demotionReason": { "enum": ["STALE", "HARMFUL", "REDUNDANT", "SUPERSEDED"] },
    "result": { "type": "string" }
  }
}
