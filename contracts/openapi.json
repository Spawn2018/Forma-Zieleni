  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-session"
      }
    },
    "parameters": {
      "LeadId": {
        "name": "leadId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "OpportunityId": {
        "name": "opportunityId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "OfferId": {
        "name": "offerId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "createdAt",
            "-createdAt",
            "updatedAt",
            "-updatedAt"
          ],
          "default": "-createdAt"
        }
      },
      "StatusFilter": {
        "name": "status",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/LeadStatus"
        }
      },
      "OpportunityStatusFilter": {
        "name": "status",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/OpportunityStatus"
        }
      },
      "OfferStatusFilter": {
        "name": "status",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/OfferStatus"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "ContractId": {
        "name": "contractId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "ContractStatusFilter": {
        "name": "status",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/ContractStatus"
        }
      }
    },
    "schemas": {
      "OpaqueId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]{15,63}$",
        "description": "Non-guessable identifier. Sequential integers are rejected."
      },
      "MarketingPlanInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal",
          "budgetPln",
          "horizonDays"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 8
          },
          "budgetPln": {
            "type": "integer",
            "minimum": 1
          },
          "horizonDays": {
            "type": "integer",
            "minimum": 14,
            "maximum": 366
          },
          "excludedChannels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MarketingPlanContract": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "synthetic",
          "label",
          "authorizesSpend",
          "authorizesPublication"
        ],
        "properties": {
          "synthetic": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "label": {
            "type": "string",
            "enum": [
              "SYNTHETIC / TEST ONLY"
            ]
          },
          "authorizesSpend": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "authorizesPublication": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "ContentProjection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          }
        }
      },
      "LeadSource": {
        "type": "string",
        "enum": [
          "www",
          "portal",
          "admin",
          "other"
        ]
      },
      "PublicLeadSource": {
        "type": "string",
        "enum": [
          "www",
          "other"
        ],
        "description": "Caller-asserted source on the unauthenticated capture route. Internal channels are assigned by the server, not by public input."
      },
      "LeadStatus": {
        "type": "string",
        "enum": [
          "received",
          "site_analysis",
          "qualified",
          "consultation_ready",
          "unqualified"
        ]
      },
      "QualificationResult": {
        "type": "string",
        "enum": [
          "pending",
          "qualified",
          "unqualified",
          "needs_review"
        ]
      },
      "QualificationReason": {
        "type": "string",
        "enum": [
          "missing_contact",
          "missing_property_context",
          "capacity_hold",
          "ready_for_consultation"
        ]
      },
      "LeadCapture": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "name",
          "phone",
          "siteAnalysisRequested"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/PublicLeadSource"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "minLength": 9,
            "maxLength": 32
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "locality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "siteAnalysisRequested": {
            "type": "boolean"
          }
        }
      },
      "LeadQualify": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capacityHold"
        ],
        "properties": {
          "capacityHold": {
            "type": "boolean"
          }
        }
      },
      "Lead": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "status",
          "contact",
          "property",
          "siteAnalysisRequested",
          "qualification",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "source": {
            "$ref": "#/components/schemas/LeadSource"
          },
          "status": {
            "$ref": "#/components/schemas/LeadStatus"
          },
          "contact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "phone"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          },
          "property": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "locality": {
                "type": "string"
              }
            }
          },
          "siteAnalysisRequested": {
            "type": "boolean"
          },
          "qualification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "reasons"
            ],
            "properties": {
              "result": {
                "$ref": "#/components/schemas/QualificationResult"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/QualificationReason"
                }
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LeadPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Lead"
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit",
              "nextCursor"
            ],
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "nextCursor": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "OpportunityStatus": {
        "type": "string",
        "enum": [
          "open"
        ],
        "description": "Domain-owned Opportunity status. Callers cannot supply or advance the status machine on create."
      },
      "OpportunityCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "leadId"
        ],
        "properties": {
          "leadId": {
            "$ref": "#/components/schemas/OpaqueId"
          }
        }
      },
      "Opportunity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "leadId",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "leadId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "status": {
            "$ref": "#/components/schemas/OpportunityStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OpportunityPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Opportunity"
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit",
              "nextCursor"
            ],
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "nextCursor": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "OfferStatus": {
        "type": "string",
        "enum": [
          "draft"
        ],
        "description": "Domain-owned Offer status. Callers cannot supply or advance the status machine on create."
      },
      "OfferCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunityId"
        ],
        "properties": {
          "opportunityId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "clientSubject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Optional portal client subject authorized to read a client-safe projection"
          }
        }
      },
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "opportunityId",
          "status",
          "clientSubject",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "opportunityId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "status": {
            "$ref": "#/components/schemas/OfferStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "clientSubject": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        }
      },
      "OfferPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit",
              "nextCursor"
            ],
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "nextCursor": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "reason"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ContractStatus": {
        "type": "string",
        "enum": [
          "draft"
        ],
        "description": "Domain-owned Contract status. Callers cannot supply signing provider or lifecycle on create."
      },
      "ContractCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offerId"
        ],
        "properties": {
          "offerId": {
            "$ref": "#/components/schemas/OpaqueId"
          }
        }
      },
      "Contract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "offerId",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "offerId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "status": {
            "$ref": "#/components/schemas/ContractStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContractPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contract"
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit",
              "nextCursor"
            ],
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "nextCursor": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "PortalSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authenticated",
          "clientId"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "clientId": {
            "type": "string",
            "enum": [
              "web",
              "portal",
              "admin",
              "mobile",
              "sketchup",
              "m2m"
            ]
          }
        }
      },
      "PortalOfferProjection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "opportunityId",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "opportunityId": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "status": {
            "$ref": "#/components/schemas/OfferStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PortalOfferPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortalOfferProjection"
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit",
              "nextCursor"
            ],
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "nextCursor": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Caller is authenticated but not authorized for this object.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Object does not exist or is not visible to the caller.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Conflict": {
        "description": "Idempotency key reused with a different body.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate or resource limit reached.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unavailable": {
        "description": "A required dependency is not ready. The body does not include connection or query details.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
