{
  "openapi": "3.0.4",
  "info": {
    "title": "Forma Zieleni Core API",
    "version": "0.1.0",
    "description": "Current-tree Core API contract. Source of truth for visitor lead qualification, staff Opportunity/Offer/Contract create/list/get. Legacy OpenAPI under legacy/ is reference only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/v1",
      "description": "Local or lab origin. Host, port and scheme are not a production hosting decision.",
      "variables": {
        "port": {
          "default": "3000"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Leads"
    },
    {
      "name": "Opportunities"
    },
    {
      "name": "Content"
    },
    {
      "name": "Growth"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is accepting local health checks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getReady",
        "security": [],
