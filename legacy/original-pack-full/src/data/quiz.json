    }
  },
  "tie_break": [
    "naturalistic",
    "classic",
    "modern",
    "family",
    "forest"
  ],
  "scoring_rules": [
    "Sumuj scores z wybranych opcji pytań, które nie zostały pominięte przez skip_if.",
    "Styl = najwyższa suma; przy remisie wygrywa styl wcześniejszy w tie_break.",
    "Poziom pielęgnacji = maintenance z odpowiedzi na pytanie maintenance, a przy braku odpowiedzi default_maintenance.",
    "Pakiet = pierwsza pasująca reguła z package_rules (wszystkie warunki w if muszą być spełnione; pusty if pasuje zawsze).",
    "criteriaUsed = etykiety z criteria_labels dla pytań, na które padła odpowiedź i które wpływają na wynik.",
    "resultNotes = notatki z result_notes, których wszystkie warunki if są spełnione (pokazywane pod wynikiem)."
  ],
  "result_notes": [
    {
      "if": {
        "sun": [
          "full"
        ],
        "maintenance": [
          "lt1"
        ]
      },
