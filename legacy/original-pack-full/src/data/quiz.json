{
  "version": 1,
  "styles": {
    "naturalistic": {
      "name": "Naturalistyczny",
      "description": "Trawy ozdobne i byliny posadzone swobodnie, jak na łące. Ogród zmienia się z miesiąca na miesiąc, przyciąga owady i ma swój urok także zimą, gdy zostawisz suche kwiatostany."
    },
    "modern": {
      "name": "Nowoczesny",
      "description": "Czyste linie, wyraźne strefy i ograniczona paleta roślin. Taras, trawnik i rabaty tworzą porządek, który dobrze łączy się z nowoczesną architekturą domu."
    },
    "forest": {
      "name": "Leśny",
      "description": "Drzewa jako główny motyw, a pod nimi paprocie, byliny cieniolubne i rośliny okrywowe. Dobry kierunek dla działek z dużą ilością cienia, na których trawnik nie chce rosnąć."
    },
    "family": {
      "name": "Rodzinny",
      "description": "Ogród zaplanowany wokół codziennego życia: miejsce do zabawy, warzywnik, strefa grilla i rośliny bezpieczne dla dzieci i zwierząt. Wszystko w zasięgu wzroku z tarasu."
    },
    "classic": {
      "name": "Rabatowy",
      "description": "Rabaty bylinowe zaplanowane tak, żeby coś kwitło od wiosny do jesieni, z żywopłotami i ścieżkami. Dla osób, które lubią spędzać czas przy roślinach."
    }
  },
