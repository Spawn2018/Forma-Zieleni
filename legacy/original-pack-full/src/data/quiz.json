  "package_rules": [
    {
      "if": {
        "stage": [
          "public_space"
        ]
      },
      "result": "b2b"
    },
    {
      "if": {
        "stage": [
          "balcony_terrace"
        ]
      },
      "package": "balcony_terrace"
    },
    {
      "if": {
        "stage": [
          "existing_garden"
        ],
        "area": [
          "lt100"
        ]
      },
      "package": "consultation"
    },
    {
      "if": {
        "area": [
          "gt800"
        ]
      },
      "package": "comprehensive"
    },
    {
      "if": {
        "stage": [
          "new_plot"
        ],
        "area": [
          "300_800"
        ]
      },
      "package": "comprehensive"
    },
    {
      "if": {},
      "package": "concept"
    }
  ],
  "package_ids_note": "consultation, concept, comprehensive, balcony_terrace muszą odpowiadać dokumentom package w Sanity (pole slug). Nazwy i ceny zawsze z CMS.",
