{
  "type": "workspace_readwrite",
  "enableSharedBuildCache": true,
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "*.npmjs.org",
      "*.githubusercontent.com",
      "github.com",
      "codeload.github.com",
      "nodejs.org",
      "registry.npmmirror.com"
    ],
    "deny": [
      "api.cloudflare.com",
      "*.workers.dev"
    ]
  }
}
